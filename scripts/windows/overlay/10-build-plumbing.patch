diff --git a/scripts/run-feature-tests.sh b/scripts/run-feature-tests.sh
index 5caea23..261b540 100644
--- a/scripts/run-feature-tests.sh
+++ b/scripts/run-feature-tests.sh
@@ -1,5 +1,5 @@
 #!/usr/bin/env bash
-# Run every feature test harness under scripts/tests/{community,core}/.
+# Run every feature test harness under scripts/tests/{community,core,linux,windows}/.
 #
 # WHY THIS EXISTS
 # ---------------
@@ -19,6 +19,7 @@
 #   scripts/run-feature-tests.sh community    # one category only
 #   scripts/run-feature-tests.sh core
 #   scripts/run-feature-tests.sh linux
+#   scripts/run-feature-tests.sh windows
 
 set -uo pipefail
 
@@ -34,17 +35,25 @@ EXPECTED_TEST_HARNESSES=103
 CATEGORIES=(community core linux)
 
 usage() {
-    echo "Usage: $(basename "$0") [community|core|linux]" >&2
+    echo "Usage: $(basename "$0") [community|core|linux|windows]" >&2
     exit 2
 }
 
 case "${1-}" in
     "")            ENFORCE_COUNT=true ;;
-    community|core|linux) CATEGORIES=("$1"); ENFORCE_COUNT=false ;;
+    community|core|linux|windows) CATEGORIES=("$1"); ENFORCE_COUNT=false ;;
     -h|--help)     usage ;;
     *)             echo "[ERROR] Unknown category: $1" >&2; usage ;;
 esac
 
+# The Windows build's own harnesses (scripts/tests/windows/) run with the full
+# suite, on top of upstream's count. Kept off upstream's count and category
+# lines so that upstream adding a harness does not break this overlay.
+if [ "$ENFORCE_COUNT" = true ]; then
+    CATEGORIES+=(windows)
+    EXPECTED_TEST_HARNESSES=$((EXPECTED_TEST_HARNESSES + 10))
+fi
+
 if ! command -v node >/dev/null 2>&1; then
     echo "[ERROR] node is required to run the feature test harnesses" >&2
     exit 1
